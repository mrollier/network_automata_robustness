   "source": [
    "col = 'source node clustering coef.'\n",
    "cc_min = df[col].min()\n",
    "cc_max = df[col].max()\n",
    "step = (cc_max - cc_min) / 5\n",
    "colors = sns.color_palette('magma_r', 5)\n",
    "for cc, cl in zip(np.arange(cc_min, cc_max, step), colors):\n",
    "    if cc+step < cc_max:\n",
    "        mask = (\n",
    "            (df[col]>=cc) &\n",
    "            (df[col]<cc+step)\n",
    "        )\n",
    "        sns.lineplot(\n",
    "            df[mask],\n",
    "            x = 'time',\n",
    "            y = 'percent of disturbed nodes',\n",
    "            errorbar = 'ci',\n",
    "            label = f'{cc:.2f} <= node cc < {cc+step:.2f}',\n",
    "            color = cl,\n",
    "        )\n",
    "    else:\n",
    "        mask = (\n",
    "            (df[col]>=cc) &\n",
    "            (df[col]<=cc+step)\n",
    "        )\n",
    "        sns.lineplot(\n",
    "            df[mask],\n",
    "            x = 'time',\n",
    "            y = 'percent of disturbed nodes',\n",
    "            errorbar = 'ci',\n",
    "            label = f'{cc:.2f} <= source node cc <= {cc+step:.2f}',\n",
    "            color = cl,\n",
    "        )"
   ]
  },
