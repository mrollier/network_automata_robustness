    "for i, col in enumerate(df_aux.columns[:-1]):\n",
    "    df_ntw.insert(i+1, f'param_{col}', df_aux[col])\n",
    "\n",
    "# show a preview\n",
    "print('shape =', df_ntw.shape)\n",
    "df_ntw.head()"
