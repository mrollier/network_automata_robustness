     "output_type": "display_data"
    }
   ],
   "source": [
    "fig, axes = plt.subplots(1, 2, figsize=(10, 4), sharey=True)\n",
    "axes[0].plot(Xpropag.T, c='blue', alpha=0.15)\n",
    "axes[1].plot(Xexpect.T, c='red', alpha=0.15)\n",
    "fig.suptitle('damage spread through network')\n",
    "axes[0].set(title='by source node (propagation)', xlabel='time step', ylabel='affected nodes (%)')\n",
    "axes[1].set(title='by target node (expectation)', xlabel='time step', ylabel='affected times (%)')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
