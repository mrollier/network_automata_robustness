   "source": [
    "def representative_mask(df, col, min_qtde=5, precision=None):\n",
    "    df_aux = df[[col, 'abbr']].copy()\n",
    "    # round column values to group easier\n",
    "    if precision is not None:\n",
    "        df_aux[col] = df_aux[col].round(precision)\n",
    "    # remove redundant data temporarialy\n",
    "    if 'time_step' in df.columns:\n",
    "        group = df_aux[(df['time_step']==0)].groupby(col)\n",
    "    else:\n",
    "        group = df_aux.groupby(col)\n",
    "    # calculate aggregated metric\n",
    "    if col.startswith('vtx_'):\n",
    "        count = group.count()\n",
    "    elif col.startswith('ntw_'):\n",
    "        count = group.nunique()\n",
    "    else:\n",
    "        raise\n",
    "    # generate subset and mask\n",
    "    subset = count[(count['abbr'] >= min_qtde)].index\n",
    "    mask = (df_aux[col].isin(subset))\n",
    "    return list(subset), mask"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 60,
   "metadata": {},
   "outputs": [],
   "source": [
    "def translate(term):\n",
    "    tr = {\n",
    "        'time_step': 'time step',\n",
    "        'defects': 'defect spread',\n",
    "        'tpeak': 'time of peak defect spread',\n",
    "        'xdinf': 'stationary defect spread',\n",
    "    }\n",
    "    return tr[term] if term in tr else term"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 58,
   "metadata": {},
   "outputs": [],
   "source": [
    "def plot_llna_family(df, res, x='time_step', y='defects', hue=None):\n",
    "    num = res**2\n",
    "    fig, axes = plt.subplots(num, num, figsize=(5*num, 5*num), sharex=True, sharey=True)\n",
    "    \n",
    "    for (i, j) in tqdm(itt.product(range(num), range(num)), total=num**2):\n",
    "        rule = f'R{res}B{i}S{j}'\n",
    "        ax = axes[i][j]\n",
    "        sns.lineplot(\n",
    "            df,\n",
    "            x = x,\n",
    "            y = f'{rule}_{y}',\n",
    "            hue = hue,\n",
    "            ax = ax\n",
    "        )\n",
    "        \n",
    "        ax.set(title=rule, ylabel=translate(y), xlabel=translate(x))\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
  },
