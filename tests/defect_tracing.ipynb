   "source": [
    "measures = pd.DataFrame({\n",
    "    'name': [ f'defect spread from rule {nm} by source vertex' for nm in rule_names ],\n",
    "    'varname': [ f'{nm}_defects' for nm in rule_names ],\n",
    "    'symbol': [ f'LLNA*(V|{nm},T=50)' for nm in rule_names ],\n",
    "    'scope': 'vertex',\n",
    "    'function': None,\n",
    "    'dependence': None,\n",
    "    'default': None,\n",
    "    'category': 'defect tracing'\n",
    "})\n",
    "datapool.update(m=measures)\n",
    "datapool.measures.tail()"
   ]
