    "axs[1,0].imshow(teps_defect[2], cmap='Greys')\n",
    "axs[1,1].imshow(teps_defect[3], cmap='Greys')\n",
    "\n",
    "axs[0,0].set_title(f\"Original defect: node {defect_nodes[0]}\")\n",
    "axs[0,1].set_title(f\"Original defect: node {defect_nodes[1]}\")\n",
